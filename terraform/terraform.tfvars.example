aws_region   = "ap-south-1"
project_name = "automobile-project"
environment  = "dev"

# No db_password needed - it's auto-generated by Terraform (random_password)
# and stored in AWS Secrets Manager. Retrieve it later with:
#   aws secretsmanager get-secret-value --secret-id automobile-project-dev-db-credentials --query SecretString --output text

# Fixes "Your current IAM principal doesn't have access to Kubernetes
# objects" in the AWS console - list the ARN of whatever identity you
# normally log into the console with (find it with:
# aws sts get-caller-identity --query Arn). Only needed if that's a
# different principal than the one running `terraform apply`.
additional_admin_arns = [
  # "arn:aws:iam::123456789012:user/your-console-user"
]
